# Copy to `.env` (never commit it) before running `docker compose up`.
# The server runs with ENVIRONMENT=production in Compose and refuses to start with default secrets.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FIELD_ENCRYPTION_KEY=

DB_USERNAME=app
DB_PASSWORD=
DB_NAME=app

# Optional
AUTOSEND_API_KEY=
# TRUSTED_PROXIES=172.16.0.0/12
