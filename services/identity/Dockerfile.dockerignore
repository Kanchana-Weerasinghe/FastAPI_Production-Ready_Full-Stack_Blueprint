# Used by `docker build -f services/identity/Dockerfile .` (the build context is the repo root).
# Allow-list: only the shared package, the central access document and this service reach the context.
*
!packages/platform-kit/
!config/access-control.json
!services/identity/
**/.venv
**/__pycache__
**/*.pyc
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.coverage
**/.htmlcov
**/coverage.xml
**/.env
**/.env.*
!services/identity/.env.example
services/identity/uploads/
services/identity/tests/
services/identity/docs/
packages/platform-kit/tests/
