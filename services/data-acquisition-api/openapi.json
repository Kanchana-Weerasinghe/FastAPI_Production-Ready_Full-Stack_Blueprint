{
  "components": {
    "schemas": {
      "FailureReport": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "FailureReport",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Job": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "canRetry": {
            "title": "Canretry",
            "type": "boolean"
          },
          "createdAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "errorMessage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errormessage"
          },
          "finishedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finishedat"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "maxAttempts": {
            "title": "Maxattempts",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ownerId": {
            "format": "uuid",
            "title": "Ownerid",
            "type": "string"
          },
          "recordsCollected": {
            "title": "Recordscollected",
            "type": "integer"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceType"
          },
          "sourceUri": {
            "title": "Sourceuri",
            "type": "string"
          },
          "startedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "ownerId",
          "name",
          "sourceType",
          "sourceUri",
          "status",
          "attempts",
          "maxAttempts",
          "canRetry",
          "recordsCollected",
          "errorMessage",
          "createdAt",
          "startedAt",
          "finishedAt",
          "version"
        ],
        "title": "Job",
        "type": "object"
      },
      "JobCreate": {
        "properties": {
          "maxAttempts": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Maxattempts",
            "type": "integer"
          },
          "name": {
            "examples": [
              "Product catalogue crawl"
            ],
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceType",
            "examples": [
              "web"
            ]
          },
          "sourceUri": {
            "examples": [
              "https://example.org/catalogue"
            ],
            "maxLength": 2048,
            "minLength": 1,
            "title": "Sourceuri",
            "type": "string"
          }
        },
        "required": [
          "name",
          "sourceType",
          "sourceUri"
        ],
        "title": "JobCreate",
        "type": "object"
      },
      "JobList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "title": "Items",
            "type": "array"
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "pageInfo"
        ],
        "title": "JobList",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "PageInfo": {
        "properties": {
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "pageSize": {
            "title": "Pagesize",
            "type": "integer"
          },
          "totalCount": {
            "title": "Totalcount",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize",
          "totalCount"
        ],
        "title": "PageInfo",
        "type": "object"
      },
      "ProgressReport": {
        "properties": {
          "records": {
            "description": "Number of new records collected since the last report",
            "minimum": 1.0,
            "title": "Records",
            "type": "integer"
          }
        },
        "required": [
          "records"
        ],
        "title": "ProgressReport",
        "type": "object"
      },
      "SourceType": {
        "enum": [
          "web",
          "api",
          "file"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
