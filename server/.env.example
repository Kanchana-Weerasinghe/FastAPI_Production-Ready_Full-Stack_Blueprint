# Copy to `server/.env` for local development (never commit it).
# Every value is optional in development. In staging/production the app fails fast if
# SECRET_KEY or DB_PASSWORD keep their defaults.

ENVIRONMENT=development
# Release identifier (set by CI to the git SHA / version tag)
APP_VERSION=0.0.0-dev
LOG_LEVEL=INFO

# --- Observability (all optional) ------------------------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=api
# OTEL_TRACES_SAMPLE_RATIO=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
METRICS_ENABLED=true
# METRICS_TOKEN=

# --- Security -------------------------------------------------------------
# Random, at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Separate random key (32+ chars) for field-level encryption at rest (e.g. MFA seeds).
# FIELD_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_VERIFIED_EMAIL=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
# Public URL of the web app, used in email links.
FRONTEND_URL=http://localhost:3000
# Base of RFC 9457 error "type" URIs (point at your error docs).
PROBLEM_TYPE_BASE_URI=https://errors.example.com
# Unset = Secure cookies everywhere except development. Production cannot disable it.
# AUTH_COOKIE_SECURE_OVERRIDE=false
APP_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For / X-Real-IP headers are trusted.
TRUSTED_PROXIES=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
# memory:// is per process; use redis://host:6379 with multiple workers/instances.
RATE_LIMIT_STORAGE_URI=memory://

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=postgres
DB_SCHEMA=public
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# true behind PgBouncer (transaction pooling)
DB_PGBOUNCER=false
DB_STATEMENT_TIMEOUT_MS=30000
DB_SLOW_QUERY_MS=500
# Optional privileged role used only by Alembic (see deploy/db/roles.sql)
# MIGRATION_DB_USERNAME=
# MIGRATION_DB_PASSWORD=
IDEMPOTENCY_TTL_HOURS=24
# Data retention (docs/governance/data-retention.md)
AUDIT_LOG_RETENTION_DAYS=400

# --- Redis / background worker -------------------------------------------
# Required by the worker (job queue + outbox relay); checked by /health/ready when set.
# REDIS_URL=redis://localhost:6379/1
# Unset = deliver outbox events in-process after commit in development, via the worker elsewhere.
# OUTBOX_INLINE_DISPATCH=true
OUTBOX_MAX_ATTEMPTS=8

# --- Outbound HTTP resilience ---------------------------------------------
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# --- File storage ---------------------------------------------------------
# local (dev/single instance) or s3 (S3, MinIO, R2, ...; required for multiple instances)
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=   # only for S3-compatible services
# S3_ACCESS_KEY_ID=  # leave empty to use IAM roles
# S3_SECRET_ACCESS_KEY=
# S3_PRESIGNED_URL_EXPIRE_SECONDS=300

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_REQUEST_BODY_BYTES=11534336
MAX_PAGE_SIZE=100

# --- Email (Autosend) -----------------------------------------------------
AUTOSEND_API_KEY=
AUTOSEND_FROM_EMAIL=welcome@yourcompany.com
AUTOSEND_FROM_NAME=Tempto
